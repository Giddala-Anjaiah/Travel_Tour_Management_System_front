# MongoDB
MONGODB_URI=mongodb://localhost:27017/traveltour

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Brevo (Brevo SMTP/API)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=TravelTour

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Extra frontend origins allowed to receive the OAuth token, comma separated.
# Any origin outside this list is ignored and FRONTEND_URL is used instead.
# FRONTEND_URLS=http://localhost:5173,http://localhost:4173

# Server
PORT=5000
